# Copy to infra/gcp/gcp.env (git-ignored) and fill in. Identifiers only: no keys, tokens or passwords.
# Every <placeholder> must be replaced; the scripts refuse to run while any remain.

# --- Project and location (Kali decides) ---
GCP_PROJECT_ID="<project-id>"
GCP_REGION="<region>"                 # see docs/cloud/README.md "Choosing a region"
GCP_ZONE="<zone>"                     # a zone inside GCP_REGION
GCS_LOCATION="<region>"               # bucket location; normally the same as GCP_REGION

# --- Storage ---
GCS_BUCKET="<globally-unique-bucket-name>"
GCS_PREFIX=astro                    # data root inside the bucket: gs://$GCS_BUCKET/$GCS_PREFIX
INTERIM_RETENTION_DAYS=14           # objects under interim/ auto-delete after this many days

# --- Service accounts (account IDs; emails are derived from the project) ---
PIPELINE_SA_NAME=astro-pipeline
DASHBOARD_SA_NAME=astro-dashboard

# --- Pipeline VM ---
VM_NAME=astro-pipeline-vm
VM_MACHINE_TYPE=e2-standard-4       # 4 vCPU / 16 GB. Smaller: e2-highmem-2 (2 vCPU / 16 GB)
VM_DISK_GB=100                      # pd-balanced boot disk; raw + unzipped CSV + Parquet fit with margin
VM_PROVISIONING=STANDARD            # STANDARD or SPOT (cheaper, but Google may stop it at any time)
VM_MAX_RUN_DURATION=12h             # hard stop after this long, as a cost safety net
VM_NETWORK_TAG=astro-pipeline
REPO_URL=https://github.com/1kaliel/astro-boys.git

# --- Team access (comma-separated, e.g. user:name@example.com). Kali fills in. ---
HARMONIZATION_MEMBERS=
DASHBOARD_MEMBERS=

# --- Dashboard on Cloud Run ---
AR_REPOSITORY=astro                 # Artifact Registry Docker repository
RUN_SERVICE=astro-dashboard
RUN_ALLOW_PUBLIC=true               # judges must open the link without logging in
