# Copy to .env and fill in. Never commit .env. Values here are placeholders only.

# --- Pipeline (same code locally and on the VM) ---
# local profile: a path (default "data"); cloud profile: gs://<GCS_BUCKET>/<prefix>
ASTRO_PROFILE=local
ASTRO_DATA_ROOT=data
ASTRO_DATASET_VERSION=v1
# DuckDB: keep memory_limit at ~50-60% of RAM. Laptop (5-8 GB): 2GB-4GB. VM (16 GB): 10GB.
DUCKDB_MEMORY_LIMIT=2GB
DUCKDB_THREADS=
DUCKDB_TEMP_DIR=

# --- NASA FIRMS API (free MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/map_key/) ---
FIRMS_MAP_KEY=

# --- Google Cloud (non-secret identifiers; fill in once Kali creates them) ---
# Authentication uses `gcloud auth application-default login` locally and the VM's
# service account in the cloud. Never put service-account key files in the repo.
GCP_PROJECT_ID=
GCS_BUCKET=
