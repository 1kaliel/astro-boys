# Cloud Run environment variables, YAML format for `gcloud run deploy --env-vars-file`.
# Copy to deploy/cloudrun/service.env (git-ignored). Non-secret values only.
# Secrets, if ever needed, go in Secret Manager and are mounted with --set-secrets, never here.

# The calendar is baked into the image (D8): ASTRO_DATA_ROOT=/app/data and ASTRO_DATASET_VERSION=v1 are set in
# app/Dockerfile. Do not set ASTRO_DATA_ROOT here: a gs:// value would hide the baked calendar.
ASTRO_DATASET_VERSION: "v1"

# The native hotspots for the CSV download (D6) are read from the bucket with the service account
# (roles/storage.objectViewer on processed/; no key files).
ASTRO_HOTSPOTS_ROOT: "gs://<GCS_BUCKET>/astro/processed/hotspots/v1"
# Which days each satellite was observing, for the Skyline (default: the sibling of ASTRO_HOTSPOTS_ROOT,
# gs://<GCS_BUCKET>/astro/processed/coverage_daily/v1, same service account). Set only to read another copy.
# ASTRO_COVERAGE_ROOT: "gs://<GCS_BUCKET>/astro/processed/coverage_daily/v1"
# Largest CSV, in rows (default 500000).
# ASTRO_CSV_MAX_ROWS: "500000"
